# Python bytecode, caches, and compiled extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Build and distribution artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
wheels/
*.whl

# Virtual environments (the committed lock file is tracked, not the environment)
.venv/
venv/

# Tool caches and reports
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.hypothesis/
.ipynb_checkpoints/
.tox/
.nox/
htmlcov/
coverage.xml
.coverage
.coverage.*
junit*.xml
pip-log.txt
pip-delete-this-directory.txt

# Local runtime state, including credentials intended for this machine only.
# Never commit real tokens, keys, or captured requests.
/.atlawire/
/secrets/
/.planning/
.pypirc

# Logs and scratch files
*.log
*.tmp
*.bak
/tmp/

# Local databases and their write-ahead/journal sidecars.
# Test fixtures (for example a tracked SQLite fixture under tests/) must not be
# ignored by a blanket *.db or *.sqlite rule; ignore only local runtime locations.
/local-data/
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# A developer-level global exclude may ignore database files; keep intentional
# fixtures trackable from this repository.
!tests/fixtures/**/*.db
!tests/fixtures/**/*.sqlite
!tests/fixtures/**/*.sqlite3

# Secrets: ignore environment files, keep only the sanitized template
.env
.env.*
!.env.example

# Editors (line-ending and workspace state, not project configuration)
.idea/
.vscode/
*.swp
*.swo
*~

# OS metadata
.DS_Store
._.DS_Store
.AppleDouble
Thumbs.db
desktop.ini

# Project-local private state (feedback, local notes)
/.config/
