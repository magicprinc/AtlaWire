ties":{".+":{"type":"string","format":"uri"}},"additionalProperties":false},"displayName":{"type":"string"},"active":{"type":"boolean"},"deleted":{"type":"boolean"},"timeZone":{"type":"string"},"locale":{"type":"string"},"groups":{"$ref":"#/definitions/simple-list-wrapper"},"applicationRoles":{"$ref":"#/definitions/simple-list-wrapper"},"expand":{"type":"string"}},"additionalProperties":false,"required":["active"]}},"additionalProperties":false}</ns3:code></ns3:pre></ns3:p></ns2:doc></ns2:representation></ns2:response><ns2:response status="400"><ns2:doc>updated project details.</ns2:doc><ns2:representation><ns2:doc>Returned if the request is not valid and the project could not be updated.</ns2:doc></ns2:representation></ns2:response><ns2:response status="401"><ns2:doc>updated project details.</ns2:doc><ns2:representation><ns2:doc>Returned if the user is not logged in.</ns2:doc></ns2:representation></ns2:response><ns2:response status="403"><ns2:doc>updated project details.</ns2:doc><ns2:representation><ns2:doc>Returned if the user does not have rights to update projects.</ns2:doc></ns2:representation></ns2:response><ns2:response status="404"><ns2:doc>updated project details.</ns2:doc><ns2:representation><ns2:doc>Returned if the project does not exist.</ns2:doc></ns2:representation></ns2:response></ns2:method><ns2:method id="deleteProject" name="DELETE"><ns2:doc>Deletes a project.</ns2:doc><ns2:response status="401"><ns2:doc>no content response</ns2:doc><ns2:representation><ns2:doc>Returned if the user is not logged in.</ns2:doc></ns2:representation></ns2:response><ns2:response status="204"><ns2:doc>no content response</ns2:doc><ns2:representation mediaType="application/json"><ns2:doc>Returned if the project is successfully deleted.</ns2:doc></ns2:representation></ns2:response><ns2:response status="403"><ns2:doc>no content response</ns2:doc><ns2:representation><ns2:doc>Returned if the currently authenticated user does not have permission to delete the project.</ns2:do