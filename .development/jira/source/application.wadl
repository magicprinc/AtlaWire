pe":"object","properties":{"key":{"type":"string"},"value":{"type":"string"}},"additionalProperties":false}</ns3:code></ns3:pre></ns3:p></ns2:doc></ns2:representation></ns2:response><ns2:response status="401"><ns2:doc>the json representation of the attribute for given permission scheme id and attribute key</ns2:doc><ns2:representation><ns2:doc>Returned if the user is not authenticated.</ns2:doc></ns2:representation></ns2:response><ns2:response status="403"><ns2:doc>the json representation of the attribute for given permission scheme id and attribute key</ns2:doc><ns2:representation><ns2:doc>Returned if the user is not an admin.</ns2:doc></ns2:representation></ns2:response><ns2:response status="404"><ns2:doc>the json representation of the attribute for given permission scheme id and attribute key</ns2:doc><ns2:representation><ns2:doc>Returned if there is no such attribute.</ns2:doc></ns2:representation></ns2:response></ns2:method></ns2:resource><ns2:resource path="{permissionSchemeId}/attribute/{key}"><ns2:param xmlns:xs="http://www.w3.org/2001/XMLSchema" name="permissionSchemeId" style="template" type="xs:long"><ns2:doc>permission scheme id</ns2:doc></ns2:param><ns2:param xmlns:xs="http://www.w3.org/2001/XMLSchema" name="key" style="template" type="xs:string"><ns2:doc>permission scheme attribute key</ns2:doc></ns2:param><ns2:method id="setSchemeAttribute" name="PUT" experimental="true"><ns2:doc>Updates or inserts the attribute for a permission scheme specified by permission scheme id.
 The attribute consists of the key and the value. The value will be converted to Boolean using Boolean#valueOf.</ns2:doc><ns2:request><ns2:representation mediaType="text/plain"><ns2:doc><ns3:p xmlns:ns3="http://www.w3.org/1999/xhtml"><ns3:h6>Schema</ns3:h6><ns3:pre><ns3:code>{"id":"https://docs.atlassian.com/jira/REST/schema/string#","title":"String","type":"string"}</ns3:code></ns3:pre></ns3:p></ns2:doc></ns2:representation></ns2:request><ns2:response status="401"><ns2:doc>no content response</ns2:doc><ns2:representation><ns2:doc>Returned if the user is not authenticated.</ns2:doc></ns2:representation></ns2:response><ns2:response status="500"><ns2:doc>no content response</ns2:doc><ns2:representation><ns2:doc>Returned if there was an error related to attribute upsert.</ns2:doc></ns2:representation></ns2:response><ns2:response status="204"><ns2:doc>no content response</ns2:doc><ns2:representation mediaType="application/json"><ns2:doc>Returned if successful.</ns2:doc></ns2:representation></ns2:response><ns2:response status="403"><ns2:doc>no content response</ns2:doc><ns2:representation><ns2:doc>Returned if the user is not an admin.</ns2:doc></ns2:representation></ns2:response></ns2:method></ns2:resource><ns2:resource path="{schemeId}/permission"><ns2:param xmlns:xs="http://www.w3.org/2001/XMLSchema" name="schemeId" style="template" type="xs:long"/><ns2:method id="getPermissionSchemeGrants" name="GET"><ns2:doc>Returns all permission grants of the given permission scheme.</ns2:doc><ns2:request><ns2:param xmlns:xs="http://www.w3.org/2001/XMLSchema" name="expand" style="query" type="xs:string"/></ns2:request><ns2:response status="200"><ns2:doc>a permission scheme entities list.</ns2:doc><ns2:representation element="permissionGrants" mediaType="application/json"><ns2:doc><ns3:p xmlns:ns3="http://www.w3.org/1999/xhtml"><ns3:h6>Example</ns3:h6><ns3:pre><ns3:code>{"permissions":[{"id":10000,"self":"http://www.example.com/jira/rest/api/2/permissionscheme/permission/10000","hol