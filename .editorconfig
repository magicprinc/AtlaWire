# EditorConfig: https://EditorConfig.org
# Core settings for a Python project. Line length 88 matches the intended Ruff default;
# revisit both here and in pyproject.toml when the tool configuration is added.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 88

[*.py]
indent_size = 4
max_line_length = 88

# Markdown: hard line breaks are meaningful; never trim trailing spaces.
[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4

[*.{json,jsonc}]
indent_size = 2

[*.{cfg,ini}]
indent_size = 4

# Makefiles require tabs for recipe lines.
[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
